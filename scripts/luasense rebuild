                local end_y = ly + dir_y * 55
                local end_z = lz + 80
                local index, damage = client.trace_bullet(player, enemyx, enemyy, enemyz + 70, end_x, end_y, end_z,true)
                if damage > 0 then result = 1 end
                dir_x, dir_y = angle_vector(0, (yaw + -90))
                end_x = lx + dir_x * 55
                end_y = ly + dir_y * 55
                end_z = lz + 80
