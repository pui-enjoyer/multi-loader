                local check, message = pcall(function()
                    local function normalize(t)
                        if type(t) ~= "table" then return t end
                        local to_rename = {}
                        for k, v in pairs(t) do
                            if type(k) == "string" then
                                local lk = k:lower()
                                if (lk == "luasense" or lk == "amphibia") and t["LS_rebuild"] == nil then
                                    to_rename[k] = "LS rebuild"
                                end
                            end
                        end
                        for old_k, new_k in pairs(to_rename) do
                            t[new_k] = t[old_k]
                            t[old_k] = nil
                        end
                        for k, v in pairs(t) do
                            if type(v) == "string" then
                                local lv = v:lower()
                                if lv == "luasense" or lv == "amphibia" then
                                    t[k] = "LS rebuild"
                                end
                            elseif type(v) == "table" then
                                normalize(v)
                            end
                        end
                        return t
                    end
