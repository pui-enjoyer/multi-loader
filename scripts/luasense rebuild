                    for _, alias in ipairs(root_aliases) do
                        if tbl[alias] and not tbl["LS_rebuild"] then
                            tbl["LS_rebuild"] = tbl[alias]
                            tbl[alias] = nil
                            break
                        end
                    end

                    normalize(tbl)

                    for i, v in next, tbl["LS_rebuild"]["extra"] do
                        if i == "submenu" then
                            ui.set(menu["aa"][i], v)
                        else
                            for index, value in next, v do
                                ui.set(menu["aa"][i][index], value)
